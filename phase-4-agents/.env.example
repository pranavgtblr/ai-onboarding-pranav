# ==============================================================================
# Model Provider Configuration (Task 4.2 - Provider-Agnostic Setup)
# Switch between providers purely by editing this configuration with 0 code changes.
# Supported providers: "google_genai" | "openai" | "mock"
# ==============================================================================

# Option 1: Google Gemini (Default)
MODEL_PROVIDER=google_genai
MODEL_NAME=gemini-3.5-flash-lite
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_google_api_key_here

# Option 2: OpenAI / Compatible (Uncomment to switch)
# MODEL_PROVIDER=openai
# MODEL_NAME=gpt-4o-mini
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_BASE_URL=https://api.openai.com/v1

# Option 3: Deterministic Offline Mock (Zero API calls / Testing)
# MODEL_PROVIDER=mock
# MODEL_NAME=mock-agent-model

REQUEST_TIMEOUT_SECONDS=30.0
